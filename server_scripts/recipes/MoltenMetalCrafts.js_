

// this can be added back later



ServerEvents.recipes(event => {

    let recipes = event.recipes;
    let create = recipes.create;


    function moltenMetal_slag(item, crushedItem, block, fluid, slag) {

        // IE Crushing
        event.custom({
            type: 'immersiveengineering:crusher',
            energy: 54000,
            input: Ingredient.of(crushedItem).toJson(),
            result: Item.of(item).toJson(),
            secondaries: [
                {
                    chance: 0.33333334,
                    output: {
                        item: slag
                    }
                }
            ]
        })

        create.mixing(
            Fluid.of(fluid, 100),
            item
        ).heated()

        create.mixing(
            Fluid.of(fluid, 150),
            crushedItem
        ).heated()

        create.mixing(
            Fluid.of(fluid, 200),
            crushedItem
        ).superheated()

        create.mixing(
            Fluid.of(fluid, 150),
            slag
        ).heated()

        create.mixing(
            Fluid.of(fluid, 200),
            slag
        ).superheated()

        create.compacting(
            block,
            Fluid.of(fluid, 900)
        )
    }


    // Molten metals

    moltenMetal_slag(
        'immersiveengineering:ingot_lead',
        'create:crushed_raw_lead',
        'immersiveengineering:storage_lead',
        'kubejs:molten_lead',
        'immersiveengineering:dust_lead'
    )

    moltenMetal_slag(
        'minecraft:iron_ingot',
        'create:crushed_raw_iron',
        'minecraft:iron_block',
        'kubejs:molten_iron',
        'immersiveengineering:dust_iron'
    )

    moltenMetal_slag(
        'minecraft:copper_ingot',
        'create:crushed_raw_copper',
        'minecraft:copper_block',
        'kubejs:molten_copper',
        'immersiveengineering:dust_copper'
    )

    moltenMetal_slag(
        'minecraft:gold_ingot',
        'create:crushed_raw_gold',
        'minecraft:gold_block',
        'kubejs:molten_gold',
        'immersiveengineering:dust_gold'
    )

    moltenMetal(
        'create:zinc_ingot',
        'create:crushed_raw_zinc',
        'create:zinc_block',
        'kubejs:molten_zinc'
    )
})